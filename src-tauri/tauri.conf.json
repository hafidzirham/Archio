{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Archio",
  "version": "1.0.0",
  "identifier": "com.archio.app",

  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },

  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Archio",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 650,
        "resizable": true
      }
    ],

    "security": {
      "csp": null,

      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "**/*"
          ]
        }
      }
    }
  },

  "bundle": {
    "active": true,
    "targets": "all",

    "resources": [
      "../resources/renderer"
    ]
  }
}